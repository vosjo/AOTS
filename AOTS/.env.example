SECRET_KEY=____secret_key_used_in_production+++keep_secret+++
DJANGO_ENV=development
DATABASE_NAME=aotsdb
DATABASE_USER=aotsuser
DATABASE_PASSWORD=long_database_password
DATABASE_HOST=localhost
DATABASE_PORT=
DEVICE=your_device_name_used_in_production
ALLOWED_HOSTS=server_url,server_ip,localhost
CSRF_TRUSTED_ORIGINS=https://server_url
LOG_DIR=/home/aots/www/aots/AOTS/logs/
DEFAULT_FROM_EMAIL=aots@example.de
CELERY_BROKER_URL=redis://localhost:6379/0
# Production / worker setup: set CELERY_TASK_ALWAYS_EAGER=False and run a Celery worker.
# Development settings force in-process tasks (memory broker) — no worker needed.
# CELERY_TASK_ALWAYS_EAGER=True
# Optional: Django cache for task ownership (defaults to redis DB 1 in production)
# CACHE_URL=redis://localhost:6379/1
BULK_DOWNLOAD_TTL_SECONDS=86400
BULK_DOWNLOAD_DELETE_AFTER_SEND=True
# SPA: show a test-installation banner on the project list (true/false)
AOTS_TEST_INSTALLATION=False
# True only for local `npm run dev`; must be False in production
VITE_DEV=False