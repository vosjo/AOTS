#!/bin/sh
# Runs the same Ruff check as CI (.github/workflows/ci.yml) before each commit.
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [ -x "$ROOT/.venv/bin/ruff" ]; then
  RUFF="$ROOT/.venv/bin/ruff"
elif [ -x "$ROOT/aotsenv/bin/ruff" ]; then
  RUFF="$ROOT/aotsenv/bin/ruff"
elif command -v ruff >/dev/null 2>&1; then
  RUFF="ruff"
else
  echo "pre-commit: ruff not found. Install it with:"
  echo "  pip install -r requirements-dev.txt"
  exit 1
fi

echo "pre-commit: ruff check AOTS stars observations analysis users"
"$RUFF" check AOTS stars observations analysis users
